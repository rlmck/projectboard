pi/
db/
# docs/ stays private, except the rollout plan (hosting source of truth) and the
# codebase overview. Must be docs/* not docs/ — git can't re-include a file inside
# an ignored directory. NEVER add an exception for docs/security-findings.md.
docs/*
!docs/rollout-plan.md
!docs/codebase-overview.md
reference/
# Archived outside the repo (11 Sep 2026). Still ignored in case they come back:
# both hold third-party code and data that must never be public.
reverse-engineering/
dtb-backup.img
*.png
*.jpg
*.img
# Claude Code's per-machine settings (saved commands can contain credentials)
.claude/settings.local.json
# Keep the board graphic (the source of board-fallback.jpg; the tools read it)
!app/ProjectBoard.png
# The app's fallback board image (ProjectBoard.png as a JPEG)
!app/board-fallback.jpg
# PWA icons (generated by tools/make_icons.py) and manifest screenshots
!app/icon-*.png
!app/apple-touch-icon.png
!app/screenshot-*.png

# Build output for Cloudflare Workers (regenerated by build.sh)
public/

# Python bytecode from tools/
__pycache__/
*.pyc
tools/hold_map_drawing.json
tools/mirror_map_gareth.json
