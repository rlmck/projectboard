# pi/ is committed (the Pi 4 listener and ops). pi/_old/ keeps the June Pi 3
# material and the stopgap copies local: problems.csv holds setters' nicknames.
# pi/config.env is the laptop's copy of the Pi's settings, which stay out of the repo.
pi/_old/
pi/config.env
laptop_key.pub
db/
# docs/ stays private, except the rollout plan (hosting source of truth) and the
# codebase overview and the cast contract. Must be docs/* not docs/ — git can't re-include a file inside
# an ignored directory. NEVER add an exception for docs/security-findings.md.
docs/*
!docs/rollout-plan.md
!docs/codebase-overview.md
!docs/cast-contract.md
!docs/screenshots/
reference/
# Archived outside the repo (11 Sep 2026). Still ignored in case they come back:
# both hold third-party code and data that must never be public.
reverse-engineering/
dtb-backup.img
*.png
*.jpg
*.img
# Claude Code's per-machine settings (saved commands can contain credentials)
.claude/settings.local.json
# Keep the board graphic (the source of board-fallback.jpg; the tools read it)
!app/ProjectBoard.png
# The app's fallback board image (ProjectBoard.png as a JPEG)
!app/board-fallback.jpg
# PWA icons (generated by tools/make_icons.py) and manifest screenshots
!app/icon-*.png
!app/apple-touch-icon.png
!app/screenshot-*.png
# Wall-screen mode screenshots (fake sample data only: the repo is public)
!docs/screenshots/wall-mode/*.png
!docs/screenshots/wall-mode/options/*.png

# Build output for Cloudflare Workers (regenerated by build.sh)
public/

# Python bytecode from tools/
__pycache__/
*.pyc
tools/hold_map_drawing.json
tools/mirror_map_gareth.json

# Supabase CLI working files (local only)
supabase/.temp/

# Pi bring-up secrets (lives only on the SD card; never commit)
secrets.env
# Generated by tools/idle_preview.py (about 3 MB)
tools/idle-preview.html
