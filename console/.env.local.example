# console/.env.local: PB Console's local settings. Copy this file to .env.local
# (gitignored) and change what you need; every line is optional. KEY=value.
# Never put a real secret in this example file: the repo is public.

# The Pi, over Tailscale (key login).
PB_HOST=pi@projectboard
# The port on 127.0.0.1 (start.sh opens it).
PB_CONSOLE_PORT=8765
# The board webcam (Tailscale only).
PB_CAM_URL=http://projectboard:8080/stream
# Another ssh to use (default: the one on the PATH, Git Bash's).
# PB_SSH=C:/Windows/System32/OpenSSH/ssh.exe
# The journal-errors tile: amber above this many in 24 h, red above the second.
PB_ERR_WARN=50
PB_ERR_BAD=500

# Later phases only (backups, activity, data edits): not read by anything yet.
# See docs/console-plan.md before filling it in.
SUPABASE_SERVICE_KEY=
