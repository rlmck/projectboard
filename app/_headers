  Cache-Control: no-cache
# The app shell is served at / (Cloudflare 307s /index.html -> /, so a rule on /index.html only hit the redirect)
/
  Cache-Control: no-cache
# Site-wide security headers. The CSP allows:
#   scripts   only our own files + Cloudflare Web Analytics' beacon (auto-injected)
#   styles    our CSS + inline style attributes (the hold overlays position dots with style="left/top")
#   images    ours, the live board photo in Supabase Storage, blob: (calibrate's photo preview)
#   connect   Supabase REST/Auth/Storage + Realtime (wss, used for casting), the analytics beacon
# Adding a new third-party origin (a CDN, font, API) means adding it here or it will be blocked.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self)
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' blob: https://uqirowyfqwiceyjznosl.supabase.co; connect-src 'self' https://uqirowyfqwiceyjznosl.supabase.co wss://uqirowyfqwiceyjznosl.supabase.co https://cloudflareinsights.com; font-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
