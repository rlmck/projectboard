#!/usr/bin/env python3
"""pb-mode: applies day/night to the screen (and later the relays). Run as root
by pb-mode.timer every minute. Plan: docs/pi4-listener-kiosk-plan.md R4 (local).

The mode is worked out from the clock each run (mode.py), and every run checks
the real state, so a missed run or a reboot changes nothing. The listener works
out the same mode for itself (LEDs and casts).

    night: stop kiosk.service, then power the HDMI output down (fb0 blank 4)
    day:   unblank, start kiosk.service if it's enabled and not running

The screen also goes off in the day while /run/projectboard/screen-off exists
(`pb-console-helper screen off`, from the console). It's in /run, so a reboot
always brings the screen back. The LEDs don't follow it: only night does that.
"""
import os
import subprocess
import sys
import syslog
import time

sys.path.insert(0, '/opt/projectboard/listener')
import mode as modelib  # noqa: E402
import power  # noqa: E402

STATE = '/run/projectboard/mode'           # the mode last applied (resets each boot)
SCREEN = '/run/projectboard/screen'        # the screen state last applied: on | off
SCREEN_OFF = '/run/projectboard/screen-off'   # the console's "screen off" in the day
BLANK = '/sys/class/graphics/fb0/blank'    # 4 = powerdown, 0 = unblank
KIOSK = 'kiosk.service'


def log(msg, level=syslog.LOG_NOTICE):
    syslog.syslog(level, msg)
    if sys.stdout.isatty():       # by hand only: under systemd stdout is the journal too
        print(msg, flush=True)


def systemctl(*args):
    return subprocess.run(['systemctl', *args], capture_output=True, text=True).stdout.strip()


def blank(value):
    try:
        with open(BLANK, 'w') as f:
            f.write(value)
        return True
    except OSError as e:
        log('screen %s failed: %s' % ('off' if value == '4' else 'on', e), syslog.LOG_WARNING)
        return False


def main():
    syslog.openlog('pb-mode')
    try:
        cfg = modelib.load_config()
    except OSError as e:
        log('config unreadable (%s): defaults' % e, syslog.LOG_WARNING)
        cfg = dict(modelib.DEFAULTS)
    mode, reason = modelib.mode_now(cfg)
    try:
        last = open(STATE).read().strip()
    except OSError:
        last = ''
    changed = mode != last
    if changed:
        log('mode %s (%s)%s' % (mode, reason, '' if not last else ', was ' + last))

    kiosk_enabled = systemctl('is-enabled', KIOSK) == 'enabled'
    kiosk_state = systemctl('is-active', KIOSK)
    kiosk_up = kiosk_state in ('active', 'activating', 'reloading')
    why = 'night' if mode == 'night' else 'screen off by hand'
    screen_off = mode == 'night' or os.path.exists(SCREEN_OFF)
    try:
        last_screen = open(SCREEN).read().strip()
    except OSError:
        last_screen = 'off' if last == 'night' else ''
    screen_changed = ('off' if screen_off else 'on') != last_screen

    if screen_off:
        if kiosk_up:
            log('%s: stopping %s' % (why, KIOSK))
            systemctl('stop', KIOSK)
            time.sleep(1)                      # let the console take the output back
            screen_changed = True
        if screen_changed and blank('4'):
            log('%s: screen off' % why)
    else:
        # Only while the console owns the screen: with cage running the write is refused.
        if (last_screen == 'off' or not kiosk_up) and blank('0') and last_screen == 'off':
            log('day: screen on')
        if kiosk_enabled and not kiosk_up:
            log('day: starting %s (was %s)' % (KIOSK, kiosk_state))
            systemctl('start', '--no-block', KIOSK)
    msg = power.leds_power(mode != 'night', cfg) if changed else None
    if msg:
        log(msg, syslog.LOG_WARNING)

    try:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE, 'w') as f:
            f.write(mode + '\n')
        with open(SCREEN, 'w') as f:
            f.write(('off' if screen_off else 'on') + '\n')
    except OSError as e:
        log('state not saved: %s' % e, syslog.LOG_WARNING)
    return 0


if __name__ == '__main__':
    sys.exit(main())
