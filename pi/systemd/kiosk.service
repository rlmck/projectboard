[Unit]
Description=Wall kiosk (cage + Chromium)
After=systemd-user-sessions.service systemd-logind.service getty@tty1.service dbus.socket
Wants=dbus.socket systemd-logind.service
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty1
StartLimitIntervalSec=0

# The app's wall-screen mode (/?wall, app/wall.js): browse and cast only.
# --deny-permission-prompts answers the cast's location request with "denied" at
# once; without it Chromium would show a permission bubble on the first cast, and
# the cast would wait on it. A refused location lets the cast through (the
# geofence is lenient, docs/cast-contract.md section 4).
# The wall key (/etc/projectboard/wall-key, made by install.sh, db/35) goes in the
# URL's #fragment, which the browser never sends anywhere: the page keeps it and
# sends it only with a problem made on the wall. $$ is systemd's literal $.
# SD-card wear (31 Oct 2026): Chromium's HTTP cache lives in RAM, in
# /run/kiosk-cache (RuntimeDirectory, emptied when the kiosk stops), capped at
# 64 MB. The profile itself stays on the card, so the service worker's offline
# copy of the app and its saved lists survive a restart.
# Outside the opening hours (mode.py, 7 Nov 2026) it doesn't start: ExecCondition
# skips it (not a failure, so no restart loop), so a boot at night keeps the
# screen dark; pb-mode stops it at closing and starts it at opening.
# Hardening (12 Nov 2026, review WALL-01/11): Chromium's managed policy
# (/etc/chromium/policies/managed/projectboard-kiosk.json, from conf/chromium-kiosk.json)
# turns DevTools, downloads, printing and every other site off, and the page itself
# blocks the long-press/right-click menu. kiosk-prestart.sh marks the last session
# as a clean exit and --hide-crash-restore-bubble is the current switch (the old
# --disable-session-crashed-bubble is kept for older builds), so no "Restore pages?"
# after a power cut or a restart. The DNS wait is 20 s, not 120: offline, the service
# worker serves the wall from its copy at once. pb-health restarts the kiosk when the
# page's heartbeat stops (a crashed renderer, a frozen page, another page on screen).
[Service]
Type=simple
User=kiosk
PAMName=kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
UtmpMode=user
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
TimeoutStartSec=150
RuntimeDirectory=kiosk-cache
RuntimeDirectoryMode=0700
ExecCondition=/usr/bin/python3 /opt/projectboard/listener/mode.py --is-day
ExecStartPre=-/opt/projectboard/ops/kiosk-prestart.sh
ExecStartPre=-/usr/bin/timeout 20 /bin/sh -c 'until getent hosts symmetryboard.co.uk >/dev/null; do sleep 2; done'
ExecStart=/bin/sh -c 'exec /usr/bin/cage -d -- /usr/bin/chromium --ozone-platform=wayland --kiosk --noerrdialogs --no-first-run --disable-infobars --disable-session-crashed-bubble --hide-crash-restore-bubble --no-default-browser-check --disable-features=Translate --password-store=basic --overscroll-history-navigation=0 --check-for-update-interval=31536000 --deny-permission-prompts --disk-cache-dir=/run/kiosk-cache --disk-cache-size=67108864 --disable-breakpad "https://symmetryboard.co.uk/?wall#k=$$(cat /etc/projectboard/wall-key 2>/dev/null)"'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
