[Unit]
Description=Wall kiosk (cage + Chromium)
After=systemd-user-sessions.service systemd-logind.service getty@tty1.service dbus.socket
Wants=dbus.socket systemd-logind.service
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty1
StartLimitIntervalSec=0

# The app's wall-screen mode (/?wall, app/wall.js): browse and cast only.
# --deny-permission-prompts answers the cast's location request with "denied" at
# once; without it Chromium would show a permission bubble on the first cast, and
# the cast would wait on it. A refused location lets the cast through (the
# geofence is lenient, docs/cast-contract.md section 4).
# The wall key (/etc/projectboard/wall-key, made by install.sh, db/35) goes in the
# URL's #fragment, which the browser never sends anywhere: the page keeps it and
# sends it only with a problem made on the wall. $$ is systemd's literal $.
[Service]
Type=simple
User=kiosk
PAMName=kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
UtmpMode=user
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
TimeoutStartSec=150
ExecStartPre=-/usr/bin/timeout 120 /bin/sh -c 'until getent hosts symmetryboard.co.uk >/dev/null; do sleep 2; done'
ExecStart=/bin/sh -c 'exec /usr/bin/cage -d -- /usr/bin/chromium --ozone-platform=wayland --kiosk --noerrdialogs --no-first-run --disable-infobars --disable-session-crashed-bubble --disable-features=Translate --password-store=basic --overscroll-history-navigation=0 --check-for-update-interval=31536000 --deny-permission-prompts "https://symmetryboard.co.uk/?wall#k=$$(cat /etc/projectboard/wall-key 2>/dev/null)"'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
