# /etc/sudoers.d/pb-deploy: lets the laptop deploy pi/ without the Pi's password
# (Ross, 30 Oct 2026: Claude Code does the Pi deploys end to end).
# Since 14 Nov 2026 (review PI-03) pi may run one root-owned program, with no
# arguments, as root: /usr/local/sbin/pb-install, which installs only a bundle signed
# by the laptop's key (/etc/projectboard/deploy-signers) and runs install.sh from a
# root-only folder. Nothing pi can write is ever run as root by this rule. (Until
# then it ran ~pi/pb-deploy/install.sh, which anything running as pi could edit.)
# The way back, if deploys stop working: pi/README.md -> Deploying.
# Installed by install.sh after `visudo -cf` passes.
pi ALL=(root) NOPASSWD: /usr/local/sbin/pb-install ""
