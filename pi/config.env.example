# /etc/projectboard/config.env: the Project Board settings on the Pi.
#
# The live file is never in the repo. Keep the laptop's copy as pi/config.env
# (gitignored): pi/deploy.sh installs it when it differs. Without one, the first
# install copies this template and stops until it's filled in.
# KEY=value, no spaces around '='. The listener re-reads the night settings
# every 30 s; anything else needs `sudo systemctl restart pb-listener`.

# Supabase (contract section 2). The anon key is public; nothing here is secret.
SUPABASE_URL=
SUPABASE_ANON_KEY=
BOARD_WALL=HangoutPortland

# LEDs. Cast brightness 0-1, then a whole-frame cap on the estimated current
# (MA_PER_CHANNEL at full, per R, G and B of each pixel).
BRIGHTNESS=0.5
STRIP_PIXELS=1200
POWER_BUDGET_MA=8000
MA_PER_CHANNEL=20

# Idle: IDLE_AFTER_S after the last cast (and at start, and at 08:00) the board
# runs Glisten, an ambient animation (pi/listener/glisten.py, where the colours
# and speeds are). A cast cuts straight in. IDLE_ANIMATION=off just clears the
# strip instead. IDLE_BRIGHTNESS scales it (0-1); IDLE_MAX_AMPS is its own
# current cap (MA_PER_CHANNEL x 3 per pixel at full white), the whole frame
# scaled down if it goes over. Needs a listener restart (a deploy does it).
IDLE_ANIMATION=on
IDLE_AFTER_S=1200
IDLE_BRIGHTNESS=1.0
IDLE_MAX_AMPS=2.0
IDLE_FPS=30

# Night mode: LEDs off, screen off, casts ignored. Worked out from the clock;
# day if the clock hasn't synced. NIGHT_FORCE=day|night overrides (tests, events).
NIGHT_MODE=on
NIGHT_START=23:00
NIGHT_END=08:00
NIGHT_FORCE=

# Network (pb-health)
WIFI_CONNECTION=hangout-fixed
WIFI_IFACE=wlan0

# Relays: a hook only, not built (pi/listener/power.py). Leave empty.
RELAY_PINS=
RELAY_ACTIVE_LOW=yes
