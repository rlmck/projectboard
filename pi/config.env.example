# /etc/projectboard/config.env: the Project Board settings on the Pi.
#
# The live file is never in the repo. Keep the laptop's copy as pi/config.env
# (gitignored): pi/deploy.sh installs it when it differs. Without one, the first
# install copies this template and stops until it's filled in.
# KEY=value, no spaces around '='. The listener re-reads the opening hours and
# the night settings every 10 s; anything else needs `sudo systemctl restart pb-listener`.

# Supabase (contract section 2). The anon key is public; nothing here is secret.
SUPABASE_URL=
SUPABASE_ANON_KEY=
BOARD_WALL=HangoutPortland

# LEDs. Cast brightness 0-1, then a whole-frame cap on the estimated current
# (MA_PER_CHANNEL at full, per R, G and B of each pixel).
BRIGHTNESS=0.5
STRIP_PIXELS=1200
# The LEDs actually on the strip, 0 to STRIP_LEDS-1 (LED 0 is behind the board and
# never lit). Board setup's LED mapping steps through 1 to STRIP_LEDS-1 (contract 11).
# 248 here: one per grid cell of the 19 x 13 board, plus LED 0. At most STRIP_PIXELS.
STRIP_LEDS=248
POWER_BUDGET_MA=8000
MA_PER_CHANNEL=20

# Idle: IDLE_AFTER_S after the last cast (and at start, and at opening) the board
# runs an idle pattern (pi/listener/patterns/, where the colours and speeds
# are). A cast cuts straight in. IDLE_ANIMATION=off just clears the strip
# instead. IDLE_PATTERN is one of glisten, chase, lava, breathe, aurora, rain,
# ripples, fireflies, teaser, wave, or cycle: then IDLE_CYCLE (names, comma or space
# separated; empty = all of them) in turn, IDLE_CYCLE_MIN minutes each, with a
# 3 s crossfade. To try them without a deploy: pb-idle on the Pi.
# IDLE_BRIGHTNESS scales every pattern (0-1); IDLE_MAX_AMPS is the idle current
# cap (MA_PER_CHANNEL x 3 per pixel at full white), the whole frame scaled down
# if it goes over. Needs a listener restart (a deploy does it).
IDLE_ANIMATION=on
IDLE_PATTERN=glisten
IDLE_CYCLE=
IDLE_CYCLE_MIN=10
IDLE_AFTER_S=900
IDLE_BRIGHTNESS=1.0
IDLE_MAX_AMPS=2.0
IDLE_FPS=30

# Circuits (cast_circuit, pi/listener/circuit.py, contract 8.3): a run that
# nobody stops (an endless run, the phone gone) goes back to idle after
# CIRCUIT_MAX_S seconds. CIRCUIT_MAP_LEVEL (0.05-0.6) is the blue map of every
# hold of the circuit through the countdown and the run; CIRCUIT_FINISH_LEVEL
# (0.1-1.0) is the red finish on the final lap of a run with a set number of
# laps. Both times BRIGHTNESS, under the current cap; a bad value is warned
# about and the default used. Needs a listener restart (a deploy does it).
CIRCUIT_MAX_S=1800
CIRCUIT_MAP_LEVEL=0.2
CIRCUIT_FINISH_LEVEL=0.6

# Opening hours (since 7 Nov 2026): the board is in day mode inside these, Europe/
# London time (the clocks changing needs nothing), and night mode outside them:
# LEDs dark, casts ignored, the wall screen off (kiosk stopped, HDMI powered
# down). Each day HH:MM-HH:MM (24:00 = midnight; an end before the start runs
# past midnight) or closed. Already 30 min either side of the gym's own hours.
# Re-read every 10 s, no restart. NIGHT_MODE=off: never dark. NIGHT_FORCE=day|night
# overrides the hours (tests). PB Console's "stay on until HH:MM" is a separate,
# self-ending override (/var/lib/projectboard/stay-on-until). Day if the clock
# hasn't synced.
HOURS_MON=15:30-22:00
HOURS_TUE=15:30-22:00
HOURS_WED=15:30-22:00
HOURS_THU=15:30-22:00
HOURS_FRI=closed
HOURS_SAT=09:30-15:00
HOURS_SUN=09:30-15:00
NIGHT_MODE=on
NIGHT_FORCE=

# Network (pb-health)
WIFI_CONNECTION=hangout-fixed
WIFI_IFACE=wlan0

# Relays: a hook only, not built (pi/listener/power.py). Leave empty.
RELAY_PINS=
RELAY_ACTIVE_LOW=yes
